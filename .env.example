# Names only. Never put values in this file; copy to .env locally and fill there (.env is git-ignored).
# Secrets are read from environment variables whose NAMES are referenced in the server config
# (for example "tokenEnv": "GITHUB_TOKEN"). The config file never holds the secret itself.

# Path to the server config file. Used when --config is not passed (the --config argument wins).
DEVWORKSPACE_CONFIG=

# Future phases. Names match packages/server/config/devworkspace.example.json; uncomment when the
# matching integration is enabled in your config.
# DEVWS_PG_URL=         # database connection (connectionStringEnv), Phase 2
# GITHUB_TOKEN=         # GitHub token (tokenEnv), Phase 3
# SAMPLE_API_TOKEN=     # custom API bearer token (auth.tokenEnv), Phase 4
