{
  "name": "devworkspace-mcp-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter devworkspace-mcp build",
    "dev": "pnpm --filter devworkspace-mcp dev",
    "test": "pnpm --filter devworkspace-mcp test",
    "sample:db": "pnpm --filter devworkspace-mcp sample:db",
    "test:postgres": "pnpm --filter devworkspace-mcp test:postgres",
    "lint": "pnpm --filter devworkspace-mcp lint",
    "typecheck": "pnpm --filter devworkspace-mcp typecheck",
    "format": "pnpm --filter devworkspace-mcp format",
    "web:dev": "pnpm --filter ik-web dev",
    "web:build": "pnpm --filter ik-web build",
    "web:lint": "pnpm --filter ik-web lint",
    "web:typecheck": "pnpm --filter ik-web typecheck"
  }
}
